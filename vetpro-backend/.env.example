PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/vetpro?schema=public"
JWT_SECRET="vetpro_super_secret_signing_key_2026_dev"
NODE_ENV=development

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password-16-caracteres
SMTP_FROM="VetPro SaaS" <tu-correo@gmail.com>
APP_URL=http://localhost:4201

# IA Clínica (Bitácora de Voz / Estructuración SOAP) - opcional
# Sin estas claves, el sistema usa un motor de reglas clínicas local (sin conexión externa)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Facturación Electrónica DIAN - Proveedor Tecnológico Autorizado (Alegra, Siigo, Facture, etc.)
# Sin estas variables, los documentos NO se transmiten ni se validan ante la DIAN (modo de pruebas)
DIAN_PROVIDER_URL=
DIAN_PROVIDER_API_KEY=

# WhatsApp Cloud API (Meta) - opcional, para envío automático de campañas de CRM
# Sin estas variables, el CRM solo genera enlaces wa.me para envío manual
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
