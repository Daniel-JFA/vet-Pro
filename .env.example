# ─────────────────────────────────────────────────────────────────────────────
# VetPro — Plantilla de Variables de Entorno de Producción
# Copiar como '.env' en el servidor y rellenar con valores reales
# ─────────────────────────────────────────────────────────────────────────────

# --- PUERTOS EN EL SERVIDOR (HOST) ---
VETPRO_DB_PORT=5435
VETPRO_BACKEND_PORT=3000
VETPRO_FRONTEND_PORT=8080

# --- BASE DE DATOS (POSTGRESQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_por_una_contrasena_segura
POSTGRES_DB=vetpro

# URL de conexión interna que usará Prisma en el contenedor backend
# NOTA: 'db' es el nombre del servicio de base de datos en docker-compose, resolverá automáticamente
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"

# --- CONFIGURACIÓN DE SEGURIDAD (BACKEND) ---
PORT=3000
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria_en_produccion
NODE_ENV=production
