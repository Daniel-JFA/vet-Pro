# ─────────────────────────────────────────────────────────────────────────────
# 🐾 VetPro SaaS — Plantilla Maestra de Variables de Entorno (Producción)
# Copiar como '.env' en la raíz y en el directorio del servidor
# ─────────────────────────────────────────────────────────────────────────────

# --- PUERTOS EN EL SERVIDOR (HOST) ---
VETPRO_DB_PORT=5435
VETPRO_BACKEND_PORT=3000
VETPRO_FRONTEND_PORT=8080

# --- BASE DE DATOS (POSTGRESQL 15) ---
POSTGRES_USER=vetpro_user
POSTGRES_PASSWORD=generar_con_openssl_rand_base64_24
POSTGRES_DB=vetpro
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"

# --- SEGURIDAD & SESIONES (JWT) ---
# OBLIGATORIO: Generar con: openssl rand -hex 64 (Mínimo 32 caracteres)
JWT_SECRET=generar_con_openssl_rand_hex_64_minimo_32_caracteres
NODE_ENV=production
PORT=3000

# --- CONTROL DE ACCESO CORS ---
ALLOWED_ORIGINS="https://vetpro.danielflorez.dev,http://localhost:4200"
APP_URL=https://vetpro.danielflorez.dev

# --- CORREO TRANSACCIONAL (SMTP / GMAIL / SENDGRID) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@vetpro.dev
SMTP_PASS=app_password_segura
SMTP_FROM="VetPro SaaS" <notificaciones@vetpro.dev>
EMAIL_BCC=auditoria@vetpro.dev

# --- PASARELA DE PAGOS (WOMPI COLOMBIA) ---
# Llaves oficiales de Wompi (Pruebas 'pub_test_' / Producción 'pub_prod_')
WOMPI_PUBLIC_KEY=pub_prod_wompi_gateway_key
WOMPI_PRIVATE_KEY=prv_prod_wompi_gateway_key
WOMPI_INTEGRITY_SECRET=prod_integrity_secret_sha256
WOMPI_EVENTS_SECRET=prod_events_secret_sha256
WOMPI_API_URL=https://production.wompi.co/v1
WOMPI_REDIRECT_URL=https://vetpro.danielflorez.dev/marketplace/payment-result

# --- INTELIGENCIA ARTIFICIAL CLÍNICA (BITÁCORA IA) ---
# Transcripción de voz médica y generación SOAP automatizada
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...

# --- COMUNICACIONES & NOTIFICACIONES (META WHATSAPP CLOUD API) ---
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_ID=1092837465...
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321...

# --- MONITOREO & OBSERVABILIDAD (SENTRY) ---
SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0
